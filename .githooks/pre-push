#!/usr/bin/env bash
# pre-push hook: enforces the fast local checks before every push (see
# CONTRIBUTING.md, "Checks"). Install with `make hooks` (once per
# clone/worktree).
#
# Tests are deliberately not run here: they are slower, and `make check`
# runs them before a pull request is opened.
#
# Emergency bypass only: SKIP_CHECK=1 git push
set -u

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

if [ "${SKIP_CHECK:-0}" = "1" ]; then
	echo "!!! WARNING: SKIP_CHECK=1 set - skipping checks before push. Emergencies only. !!!" >&2
	exit 0
fi

start_ts=$(date +%s)
make build typecheck lint ascii validate-specs
status=$?
end_ts=$(date +%s)
elapsed=$((end_ts - start_ts))

if [ "$status" -ne 0 ]; then
	echo "pre-push: checks failed after ${elapsed}s - push refused" >&2
	exit 1
fi

echo "pre-push: checks passed in ${elapsed}s"
exit 0
