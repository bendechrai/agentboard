# Pinned dev toolchain for agentboard.
#
# Pins the same Node version for every contributor, independent of what
# is installed on the host. Built with `docker compose build dev` and
# run with `make check-in-docker` / `make dev-shell`.

FROM node:22-bookworm-slim

ARG UID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
        make \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${UID} dev \
    && useradd -m -u ${UID} -g dev -s /bin/bash dev \
    && mkdir -p /workspace /home/dev/.npm \
    && chown -R dev:dev /workspace /home/dev

USER dev

ENV HOME=/home/dev

WORKDIR /workspace
