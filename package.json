{
  "name": "@bendechrai/agentboard",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A local, offline, conflict-free ticket board for AI agents working on one project.",
  "license": "MIT",
  "author": "Ben Dechrai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bendechrai/agentboard.git"
  },
  "homepage": "https://github.com/bendechrai/agentboard#readme",
  "bugs": {
    "url": "https://github.com/bendechrai/agentboard/issues"
  },
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "agentboard": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/client",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run build && npm run typecheck && npm run lint && npm run test",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "preact": "^10.29.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
